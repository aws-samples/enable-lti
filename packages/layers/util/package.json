{
  "name": "@enable-lti/util",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "dependencies": {
    "@aws-lambda-powertools/commons": "^1.18.1",
    "@aws-lambda-powertools/logger": "^1.18.1",
    "@aws-lambda-powertools/metrics": "^1.18.1",
    "@aws-lambda-powertools/tracer": "^1.18.1",
    "@aws-sdk/client-dynamodb": "^3.1003.0",
    "@aws-sdk/client-kms": "^3.1003.0",
    "@aws-sdk/client-ssm": "^3.1003.0",
    "@aws-sdk/client-sqs": "^3.1003.0",
    "@aws-sdk/client-sns": "^3.1003.0",
    "@aws-sdk/util-dynamodb": "^3.996.2",
    "axios": "^1.13.6",
    "@aws-sdk/signature-v4": "^3.374.0",
    "html-escaper": "^3.0.3",
    "jose": "^4.15.9",
    "node-forge": "^1.4.0",
    "uuid": "^9.0.1"
  },
  "scripts": {
    "prebuild": "rm -rf ../../../dist/layers/util",
    "build": "tsc -b",
    "postbuild": "DEST=../../../dist/layers/util/nodejs/node_modules && WORKSPACE_ROOT=../../../node_modules && npm ls --all --omit=dev --parseable | tail --lines=+3 | sort | uniq | while read dep; do pkgname=$(node -e \"var p='$dep'; var nm=p.lastIndexOf('node_modules/'); console.log(p.substring(nm+'node_modules/'.length))\"); mkdir -p \"$DEST/$(dirname $pkgname)\"; cp -R \"$dep\" \"$DEST/$(dirname $pkgname)/\"; done",
    "test": "jest --passWithNoTests --all --updateSnapshot",
    "eslint": "eslint src/**/**.ts",
    "eslint:fix": "eslint src/**/**.ts --fix"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/html-escaper": "^3.0.4",
    "@types/node-forge": "^1.3.14",
    "@types/uuid": "^8.3.4"
  }
}
